<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>br.com.hidrovigia</groupId>
  <artifactId>hidrovigia</artifactId>
  <version>1.0.0</version>
  <name>HidroVigia</name>
  <description>PoC de vigilancia da qualidade da agua em sistemas de abastecimento de pequeno porte (ODS 6)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.6.0</springdoc.version>
    <jacoco.version>0.8.12</jacoco.version>
    <cobertura.minima>0.70</cobertura.minima>
    <!--
      Sobrepoe a versao gerenciada pelo Spring Boot 3.3.5 (1.19.8). O
      docker-java embutido naquela versao negocia uma versao de API que o
      Docker Engine 29 ja nao aceita, e o Testcontainers responde marcando o
      ambiente como "sem Docker" — os testes de integracao eram pulados em
      silencio em qualquer maquina com Docker atual.
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Fixa a versao da API do Docker que o Testcontainers negocia.

        Sem isto, o docker-java pede uma versao antiga (< 1.40) que o Docker
        Engine 29 recusa com HTTP 400. O Testcontainers le a recusa como
        "nao ha Docker nesta maquina" e, por causa de disabledWithoutDocker,
        PULA os testes de integracao sem falhar: o build fica verde sem ter
        encostado no banco. Foi exatamente o que aconteceu aqui, e escondeu um
        defeito real (duas ocorrencias para a mesma analise).

        1.41 e aceita por todo engine do Docker 20.10 (2020) ao 29, entao serve
        igual na maquina de cada um e no runner da CI.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <api.version>1.41</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        JaCoCo: gera o relatorio de cobertura e reprova o build abaixo de 70%.
        O edital exige "evidencia reproduzivel" da medicao, entao a checagem
        roda amarrada na fase verify: `mvn clean verify` e o unico comando
        necessario para produzir o relatorio e validar o minimo.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <!-- Classe de bootstrap e configuracao: sem regra de negocio -->
            <exclude>br/com/hidrovigia/HidroVigiaApplication.class</exclude>
            <exclude>br/com/hidrovigia/config/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>gerar-relatorio</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>verificar-minimo</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.minima}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <!--
    Front-end React/Vite: OPT-IN, so com -Pfrontend.

    Fora deste perfil o build nao encosta em Node. `./mvnw clean verify`
    continua exigindo apenas JDK 21 e Docker, como esta documentado no README,
    e continua sendo a evidencia reproduzivel de cobertura que o edital pede:
    quem mexe so em backend nao precisa instalar Node, e uma falha do registro
    do npm nao reprova a medicao de cobertura.

    Com o perfil: npm ci + npm run build, e a saida (frontend/dist) e copiada
    para target/classes/static, de onde o proprio Spring serve a SPA.

    A copia acontece em process-resources, e nao em prepare-package, porque o
    spring-boot:run so leva o ciclo ate test-compile. Ligando aqui,
    `./mvnw -Pfrontend spring-boot:run` serve API, SPA e Swagger em :8080 num
    unico comando — que e como a demonstracao e gravada.
  -->
  <profiles>
    <profile>
      <id>frontend</id>

      <properties>
        <!-- Manter em sincronia com frontend/.nvmrc -->
        <node.version>v24.15.0</node.version>
        <frontend.plugin.version>1.15.1</frontend.plugin.version>
      </properties>

      <build>
        <plugins>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <version>${frontend.plugin.version}</version>
            <configuration>
              <workingDirectory>frontend</workingDirectory>
              <!--
                Fora de target/: sobrevive ao `clean` e evita rebaixar o Node a
                cada build limpo. Ignorado no .gitignore.
              -->
              <installDirectory>frontend/.node</installDirectory>
            </configuration>
            <executions>
              <execution>
                <id>instala-node-e-npm</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <configuration>
                  <nodeVersion>${node.version}</nodeVersion>
                </configuration>
              </execution>
              <execution>
                <!-- npm ci, e nao npm install: reprova se o lockfile divergir
                     do package.json, em vez de resolver versoes em silencio. -->
                <id>npm-ci</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>npm</goal>
                </goals>
                <configuration>
                  <arguments>ci</arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-build</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>npm</goal>
                </goals>
                <configuration>
                  <arguments>run build</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copia-spa-para-static</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <!--
                    target/classes/static, nunca src/main/resources/static: o
                    `clean` nao limparia a segunda, e um bundle velho
                    continuaria sendo servido depois de mudar o front.
                  -->
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>frontend/dist</directory>
                      <!--
                        Obrigatorio: o Vite gera JS com ${...} e arquivos
                        binarios. Filtrar corromperia o bundle.
                      -->
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>

</project>
