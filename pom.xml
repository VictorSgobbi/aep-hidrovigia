<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>br.com.hidrovigia</groupId>
  <artifactId>hidrovigia</artifactId>
  <version>1.0.0</version>
  <name>HidroVigia</name>
  <description>PoC de vigilancia da qualidade da agua em sistemas de abastecimento de pequeno porte (ODS 6)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.6.0</springdoc.version>
    <jacoco.version>0.8.12</jacoco.version>
    <cobertura.minima>0.70</cobertura.minima>
    <!--
      Sobrepoe a versao gerenciada pelo Spring Boot 3.3.5 (1.19.8). O
      docker-java embutido naquela versao negocia uma versao de API que o
      Docker Engine 29 ja nao aceita, e o Testcontainers responde marcando o
      ambiente como "sem Docker" — os testes de integracao eram pulados em
      silencio em qualquer maquina com Docker atual.
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Fixa a versao da API do Docker que o Testcontainers negocia.

        Sem isto, o docker-java pede uma versao antiga (< 1.40) que o Docker
        Engine 29 recusa com HTTP 400. O Testcontainers le a recusa como
        "nao ha Docker nesta maquina" e, por causa de disabledWithoutDocker,
        PULA os testes de integracao sem falhar: o build fica verde sem ter
        encostado no banco. Foi exatamente o que aconteceu aqui, e escondeu um
        defeito real (duas ocorrencias para a mesma analise).

        1.41 e aceita por todo engine do Docker 20.10 (2020) ao 29, entao serve
        igual na maquina de cada um e no runner da CI.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <api.version>1.41</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        JaCoCo: gera o relatorio de cobertura e reprova o build abaixo de 70%.
        O edital exige "evidencia reproduzivel" da medicao, entao a checagem
        roda amarrada na fase verify: `mvn clean verify` e o unico comando
        necessario para produzir o relatorio e validar o minimo.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <!-- Classe de bootstrap e configuracao: sem regra de negocio -->
            <exclude>br/com/hidrovigia/HidroVigiaApplication.class</exclude>
            <exclude>br/com/hidrovigia/config/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>gerar-relatorio</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>verificar-minimo</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.minima}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
